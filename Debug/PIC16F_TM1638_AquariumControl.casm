/*********************************************************************************************
  void oneWireBusReset()
  First part of the reset routine - drive the bus low for 500us
*********************************************************************************************/
void oneWireBusReset() {

    char isPresent;
    oneWireTris = 1; // start with high
0899  1683  	BSF STATUS, RP0
089A  1303  	BCF STATUS, RP1
089B  1687  	BSF gbl_trisc,5

    isPresent = 0;
089C  1283  	BCF STATUS, RP0
089D  01F4  	CLRF oneWireBus_00014_1_isPresent

    // Send the reset pulse - drive low for 500us
    oneWireBus = 0;
089E  1287  	BCF gbl_portc,5

    oneWireTris = 0;
089F  1683  	BSF STATUS, RP0
08A0  1287  	BCF gbl_trisc,5

    delay_10us(50);
08A1  3032  	MOVLW 0x32
08A2  1283  	BCF STATUS, RP0
08A3  00F9  	MOVWF delay_10us_00000_arg_del
08A4  118A  	BCF PCLATH,3
08A5  207A  	CALL delay_10us_00000

    // Release line and wait 70us for PD Pulse
    oneWireTris = 1;
08A6  1683  	BSF STATUS, RP0
08A7  1687  	BSF gbl_trisc,5

    delay_10us(7);
08A8  3007  	MOVLW 0x07
08A9  1283  	BCF STATUS, RP0
08AA  00F9  	MOVWF delay_10us_00000_arg_del
08AB  207A  	CALL delay_10us_00000

    // Now sample, if there is a sensor on the bus, the line should be low
    if (oneWireBus) {
08AC  1A87  	BTFSC gbl_portc,5

        oneWireIsPresent = 0; // no devices
08AD  01F2  	CLRF gbl_oneWireIsPresent

    }
    delay_10us(50);
08AE  3032  	MOVLW 0x32
08AF  00F9  	MOVWF delay_10us_00000_arg_del
08B0  207A  	CALL delay_10us_00000

}
08B1  0008  	RETURN


/*********************************************************************************************
  void oneWireTxByte(char data)
  Transmits a single byte from the bus
*********************************************************************************************/
void oneWireTxByte(char cData) {

    char cTemp = 1;
0183  3001  	MOVLW 0x01
0184  00F7  	MOVWF oneWireTxB_00015_1_cTemp

    // Loop through the eight bits in the byte
    for (char i = 0; i < 8; i++) {
0185  01F8  	CLRF oneWireTxB_00015_2_i
0186        label26
0186  3008  	MOVLW 0x08
0187  0278  	SUBWF oneWireTxB_00015_2_i, W
0188  1803  	BTFSC STATUS,C
019D  0AF8  	INCF oneWireTxB_00015_2_i, F
019E  2986  	GOTO	label26

        // Send the LSB first

        // Drive the line low initially for 3us
        oneWireTris = 0;
018A  1683  	BSF STATUS, RP0
018B  1287  	BCF gbl_trisc,5

        oneWireBus = 0;
018C  1283  	BCF STATUS, RP0
018D  1287  	BCF gbl_portc,5


        // Delay not needed for 4MHz PIC
        //delay_us(3); // Delay 3us

        if (cData & cTemp) {
018E  0877  	MOVF oneWireTxB_00015_1_cTemp, W
018F  0576  	ANDWF oneWireTxB_00015_arg_cData, W
0190  1903  	BTFSC STATUS,Z
0191  2994  	GOTO	label27

            oneWireTris = 1; // Release the bus
0192  1683  	BSF STATUS, RP0
0193  1687  	BSF gbl_trisc,5

        }

        delay_10us(5); // Delay 60us - 50us works fine with code delays
0194  3005  	MOVLW 0x05
0195  1283  	BCF STATUS, RP0
0196  00F9  	MOVWF delay_10us_00000_arg_del
0197  207A  	CALL delay_10us_00000

        oneWireTris = 1; // Release the bus
0198  1683  	BSF STATUS, RP0
0199  1687  	BSF gbl_trisc,5


        // move the test bit
        cTemp <<= 1;
019A  1003  	BCF STATUS,C
019B  1283  	BCF STATUS, RP0
019C  0DF7  	RLF oneWireTxB_00015_1_cTemp, F

    }
}
0189  0008  	RETURN


/*********************************************************************************************
  void oneWireTxBytes(char data, char data2)
  Transmits a 2 bytes from the bus
*********************************************************************************************/
void oneWireTxBytes(char cData, char cData2) {

    // Reset first - done in main
    //oneWireBusReset();
    // Send first byte
    oneWireTxByte(cData);
04E1  0874  	MOVF oneWireTxB_00016_arg_cData, W
04E2  00F6  	MOVWF oneWireTxB_00015_arg_cData
04E3  2183  	CALL oneWireTxB_00015

    // Send second byte
    oneWireTxByte(cData2);
04E4  0875  	MOVF oneWireTxB_00016_arg_cData2, W
04E5  00F6  	MOVWF oneWireTxB_00015_arg_cData
04E6  2183  	CALL oneWireTxB_00015

}
04E7  0008  	RETURN


/*********************************************************************************************
  char oneWireRxByte()
  Receives a single byte from the bus
*********************************************************************************************/
char oneWireRxByte() {

    char cDataIn = 0;
04E8  1283  	BCF STATUS, RP0
04E9  1303  	BCF STATUS, RP1
04EA  01F4  	CLRF oneWireRxB_00017_1_cDataIn

    // Loop through the eight bits in the byte
    for(char i = 0; i < 8; i++) {
04EB  01F5  	CLRF oneWireRxB_00017_2_i
04EC        label100
04EC  3008  	MOVLW 0x08
04ED  0275  	SUBWF oneWireRxB_00017_2_i, W
04EE  1803  	BTFSC STATUS,C
04EF  2D02  	GOTO	label101
0500  0AF5  	INCF oneWireRxB_00017_2_i, F
0501  2CEC  	GOTO	label100
0502        label101

        // Shift data already received left
        cDataIn >>= 1;
04F0  1003  	BCF STATUS,C
04F1  0CF4  	RRF oneWireRxB_00017_1_cDataIn, F


        // Bring bus low for 1us
        oneWireTris = 0;
04F2  1683  	BSF STATUS, RP0
04F3  1287  	BCF gbl_trisc,5

        oneWireBus = 0;
04F4  1283  	BCF STATUS, RP0
04F5  1287  	BCF gbl_portc,5

        // no delay needed here for 4MHz PIC
        // Release bus
        oneWireTris = 1;
04F6  1683  	BSF STATUS, RP0
04F7  1687  	BSF gbl_trisc,5


        // Sample within 15us
        // At 4MHz, delay overhead 10us, unit delay 1us, resolution 4 units
        // 4us using delay_us is too slow as sometimes reads all 1s, use nops instead
        //delay_us(4); // Delay 16us
        nop();
04F8  0000  	NOP

        nop();
04F9  0000  	NOP


        // Check the value of the onewire bus - set the MSB of cDataIn if so
        if (oneWireBus) // check takes 2us
04FA  1283  	BCF STATUS, RP0
04FB  1A87  	BTFSC gbl_portc,5

            cDataIn.7 = 1;
04FC  17F4  	BSF oneWireRxB_00017_1_cDataIn,7


        // To finish time slot
        delay_10us(6); // 60us (really 65us at 4MHz)
04FD  3006  	MOVLW 0x06
04FE  00F9  	MOVWF delay_10us_00000_arg_del
04FF  207A  	CALL delay_10us_00000

    }

    return cDataIn;
0502  0874  	MOVF oneWireRxB_00017_1_cDataIn, W
0503  00F5  	MOVWF CompTempVarRet549

}
0504  0008  	RETURN




