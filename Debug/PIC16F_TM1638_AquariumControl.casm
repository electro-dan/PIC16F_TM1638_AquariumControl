05FB  3044  	MOVLW 0x44
05FC  00F7  	MOVWF i2c_WRITE_00000_arg_i2c_data
05FD  20A9  	CALL i2c_WRITE_00000

    i2c_write(gBcdWhiteOnMinute);
05FE  0855  	MOVF gbl_gBcdWhiteOnMinute, W
05FF  00F7  	MOVWF i2c_WRITE_00000_arg_i2c_data
0600  20A9  	CALL i2c_WRITE_00000

    i2c_write(gBcdWhiteOnHour);
0601  0856  	MOVF gbl_gBcdWhiteOnHour, W
0602  00F7  	MOVWF i2c_WRITE_00000_arg_i2c_data
0603  20A9  	CALL i2c_WRITE_00000

    i2c_write(gBcdWhiteOffMinute);
0604  0857  	MOVF gbl_gBcdWhiteOffMinute, W
0605  00F7  	MOVWF i2c_WRITE_00000_arg_i2c_data
0606  20A9  	CALL i2c_WRITE_00000

    i2c_write(gBcdWhiteOffHour);
0607  0858  	MOVF gbl_gBcdWhiteOffHour, W
0608  00F7  	MOVWF i2c_WRITE_00000_arg_i2c_data
0609  20A9  	CALL i2c_WRITE_00000

    i2c_write(gBcdBlueOnMinute);
