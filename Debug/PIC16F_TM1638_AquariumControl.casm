/*********************************************************************************************
  void tm1638ByteWrite(char bWrite)
  Write one byte
  from http://www.piclearning.net/280/pic-and-tm1638-ledkey-module.php
*********************************************************************************************/
void tm1638ByteWrite(char bWrite) {

    for (char i = 0; i < 8; i++) {
0170  01F9  	CLRF tm1638Byte_0001E_2_i
0171        label25
0171  3008  	MOVLW 0x08
0172  0279  	SUBWF tm1638Byte_0001E_2_i, W
0173  1803  	BTFSC STATUS,C
0181  0AF9  	INCF tm1638Byte_0001E_2_i, F
0182  2971  	GOTO	label25

        tm1638dio = (bWrite & 0x01);
0175  3001  	MOVLW 0x01
0176  0578  	ANDWF tm1638Byte_0001E_arg_bWrite, W
0177  00FA  	MOVWF CompTempVar553
0178  187A  	BTFSC CompTempVar553,0
0179  1486  	BSF gbl_portb,1
017A  1C7A  	BTFSS CompTempVar553,0
017B  1086  	BCF gbl_portb,1

        tm1638clk = 0;
017C  1106  	BCF gbl_portb,2

        bWrite = (bWrite >> 1);
017D  08F8  	MOVF tm1638Byte_0001E_arg_bWrite, F
017E  1003  	BCF STATUS,C
017F  0CF8  	RRF tm1638Byte_0001E_arg_bWrite, F

        tm1638clk = 1;
0180  1506  	BSF gbl_portb,2

    }
}
