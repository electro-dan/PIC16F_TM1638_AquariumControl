/*********************************************************************************************
  void processKeys()
  Action a key press
*********************************************************************************************/
void processKeys() {

    // Key hex codes based on result from tm1638ReadKeys, from http://www.piclearning.net/280/pic-and-tm1638-ledkey-module.php
    switch (tm1638Keys) {

        case 0x1F:
082B  1283  	BCF STATUS, RP0
082C  1303  	BCF STATUS, RP1
082D  086D  	MOVF gbl_tm1638Keys, W
082E  3A1F  	XORLW 0x1F
082F  1903  	BTFSC STATUS,Z
0830  2847  	GOTO	label140
0847        label140

            // Toggle white light on/off
            WHITE_LED = !WHITE_LED;
0847  01F5  	CLRF CompTempVar644
0848  1C87  	BTFSS gbl_portc,1
0849  0AF5  	INCF CompTempVar644, F
084A  1875  	BTFSC CompTempVar644,0
084B  1487  	BSF gbl_portc,1
084C  1C75  	BTFSS CompTempVar644,0
084D  1087  	BCF gbl_portc,1

            break;
        case 0x17:
0831  3A08  	XORLW 0x08
0832  1903  	BTFSC STATUS,Z
0833  284F  	GOTO	label141
084F        label141

            // Toggle blue light on/off
            BLUE_LED = !BLUE_LED;
084F  01F5  	CLRF CompTempVar645
0850  1D07  	BTFSS gbl_portc,2
0851  0AF5  	INCF CompTempVar645, F
0852  1875  	BTFSC CompTempVar645,0
0853  1507  	BSF gbl_portc,2
0854  1C75  	BTFSS CompTempVar645,0
0855  1107  	BCF gbl_portc,2

            break;
        case 0x0F:
0834  3A18  	XORLW 0x18
0835  1903  	BTFSC STATUS,Z
0836  2857  	GOTO	label142
0857        label142

            // Toggle fan on/off
            gbFanOn = !gbFanOn;
0857  01F5  	CLRF CompTempVar646
0858  1C50  	BTFSS gbl_gbFanOn,0
0859  0AF5  	INCF CompTempVar646, F
085A  1050  	BCF gbl_gbFanOn,0
085B  0875  	MOVF CompTempVar646, W
085C  1D03  	BTFSS STATUS,Z
085D  1450  	BSF gbl_gbFanOn,0

            break;
        case 0x07:
0837  3A08  	XORLW 0x08
0838  1903  	BTFSC STATUS,Z
0839  285F  	GOTO	label143
085F        label143

            // Exit other modes
            if (gcTriggerMode)
085F  08D4  	MOVF gbl_gcTriggerMode, F
0861  1D03  	BTFSS STATUS,Z

                at24c32WriteAll(); // Exiting trigger mode, save the new triggers to EEPROM chip
0860  118A  	BCF PCLATH,3
0862  25F3  	CALL at24c32Wri_00018

            gcSetMode = 0;
0863  01D2  	CLRF gbl_gcSetMode

            gcTriggerMode = 0;
0864  01D4  	CLRF gbl_gcTriggerMode

            // Display temp C/temp F/date
            gcDisplayMode++;
0865  0AD1  	INCF gbl_gcDisplayMode, F

            if (gcDisplayMode > 3)
0866  0851  	MOVF gbl_gcDisplayMode, W
0867  3C03  	SUBLW 0x03
0868  1C03  	BTFSS STATUS,C

                gcDisplayMode = 0;
0869  01D1  	CLRF gbl_gcDisplayMode

            convertTemp(); // force conversion (no read)
086A  2554  	CALL convertTem_00027

            break;
        case 0x1B:
083A  3A1C  	XORLW 0x1C
083B  1903  	BTFSC STATUS,Z
083C  286C  	GOTO	label144
086C        label144

            // Exit other modes
            gcTriggerMode = 0;
086C  01D4  	CLRF gbl_gcTriggerMode

            // Adjust set mode
            gcSetMode++;
086D  0AD2  	INCF gbl_gcSetMode, F

            if (gcSetMode > 7) {
086E  0852  	MOVF gbl_gcSetMode, W
086F  3C07  	SUBLW 0x07
0870  1803  	BTFSC STATUS,C

                ds3231WriteDateTime();
0872  118A  	BCF PCLATH,3
0873  2518  	CALL ds3231Writ_0001B

                gcSetMode = 0;
0874  01D2  	CLRF gbl_gcSetMode

            }
            break;
        case 0x13:
083D  3A08  	XORLW 0x08
083E  1903  	BTFSC STATUS,Z
083F  2876  	GOTO	label145
0876        label145

            // Adjust down
            iBcdAdjustment = 0;
0876  01F1  	CLRF gbl_iBcdAdjustment

            if (gcSetMode) {
0877  08D2  	MOVF gbl_gcSetMode, F
0878  1903  	BTFSC STATUS,Z
0879  287D  	GOTO	label146
087D        label146

                adjustDateTime();
087A  118A  	BCF PCLATH,3
087B  2769  	CALL adjustDate_00028

            } else if (gcTriggerMode) {
087D  08D4  	MOVF gbl_gcTriggerMode, F
087F  1D03  	BTFSS STATUS,Z

                adjustTrigger();
087E  118A  	BCF PCLATH,3
0880  2696  	CALL adjustTrig_00029

            }
            break;
        case 0x0B:
0840  3A18  	XORLW 0x18
0841  1903  	BTFSC STATUS,Z
0842  2882  	GOTO	label147
0882        label147

            iBcdAdjustment = 1;
0882  3001  	MOVLW 0x01
0883  00F1  	MOVWF gbl_iBcdAdjustment

            // Adjust up
            if (gcSetMode) {
0884  08D2  	MOVF gbl_gcSetMode, F
0885  1903  	BTFSC STATUS,Z
0886  288A  	GOTO	label148
088A        label148

                adjustDateTime();
0887  118A  	BCF PCLATH,3
0888  2769  	CALL adjustDate_00028

            } else if (gcTriggerMode) {
088A  08D4  	MOVF gbl_gcTriggerMode, F
088C  1D03  	BTFSS STATUS,Z

                adjustTrigger();
088B  118A  	BCF PCLATH,3
088D  2696  	CALL adjustTrig_00029

            }
            break;
        case 0x03:
0843  3A08  	XORLW 0x08
0844  1903  	BTFSC STATUS,Z
0845  288F  	GOTO	label149
088F        label149

            // Exit set mode
            gcSetMode = 0;
088F  01D2  	CLRF gbl_gcSetMode

            // Adjust timer mode
            gcTriggerMode++;
0890  0AD4  	INCF gbl_gcTriggerMode, F

            if (gcTriggerMode > 16) {
0891  0854  	MOVF gbl_gcTriggerMode, W
0892  3C10  	SUBLW 0x10
0893  1803  	BTFSC STATUS,C

                at24c32WriteAll(); // Exiting trigger mode, save the new triggers to EEPROM chip
0895  118A  	BCF PCLATH,3
0896  25F3  	CALL at24c32Wri_00018

                gcTriggerMode = 0;
0897  01D4  	CLRF gbl_gcTriggerMode

            }
            break;
    }
}
