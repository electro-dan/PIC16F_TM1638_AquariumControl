			l_sda_tris = 0; // SDA to output (driven low)
0146  1683  	BSF STATUS, RP0
0147  1207  	BCF i2c_START_00000_1_l_sda_tris,4


			delay_us(dly);					
0148  300A  	MOVLW 0x0A
0149  1283  	BCF STATUS, RP0
