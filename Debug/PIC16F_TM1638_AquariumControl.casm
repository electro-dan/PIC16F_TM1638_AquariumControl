01DE  1283  	BCF STATUS, RP0
01DF  02FD  	SUBWF intToBcd_00000_arg_iValue, F
01E0  1C03  	BTFSS STATUS,C
01E1  03FE  	DECF intToBcd_00000_arg_iValue+D'1', F

        // each time we take off 10, the left most digit is incremented
        iBcdOut += 0x10;
