		if (l_scl && l_sda)
0138  1D87  	BTFSS i2c_START_00000_1_l_scl,3
0139  2957  	GOTO	label24
013A  1E07  	BTFSS i2c_START_00000_1_l_sda,4
013B  2957  	GOTO	label24
