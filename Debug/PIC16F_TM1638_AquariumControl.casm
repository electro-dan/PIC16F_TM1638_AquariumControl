/*********************************************************************************************
  void interrupt()
  Interrupt handler
*********************************************************************************************/
void interrupt() {

    // Interrupt on timer0 - flash digit delay
    if (intcon.T0IF) {
0A84  1D0B  	BTFSS gbl_intcon,2
0A85  2A8C  	GOTO	label178
0A8C        label178

        tmr0 = TMR0PRELOAD;
0A86  303D  	MOVLW 0x3D
0A87  1283  	BCF STATUS, RP0
0A88  1303  	BCF STATUS, RP1
0A89  0081  	MOVWF gbl_tmr0

        cTask.TASK_TIMER0 = 1;
0A8A  14CF  	BSF gbl_cTask,1

        // Clear interrupt flag
        intcon.T0IF = 0;
0A8B  110B  	BCF gbl_intcon,2

    }
    // Handle timer1 interrupt - delay counter from DS3231
    if (pir1.TMR1IF) {
0A8C  1283  	BCF STATUS, RP0
0A8D  1303  	BCF STATUS, RP1
0A8E  1C0C  	BTFSS gbl_pir1,0
0A8F  2A95  	GOTO	label179
0A95        label179

        tmr1h = TMR1HV;      // preset for timer1 MSB register
0A90  30FF  	MOVLW 0xFF
0A91  008F  	MOVWF gbl_tmr1h

        tmr1l = TMR1LV;      // preset for timer1 LSB register
0A92  008E  	MOVWF gbl_tmr1l


        pir1.TMR1IF = 0;     // Clear interrupt flag
0A93  100C  	BCF gbl_pir1,0

        cTask.TASK_TIMER1 = 1;
0A94  154F  	BSF gbl_cTask,2

    }
}
0A95  0E32  	SWAPF Int1BContext+D'2', W
0A96  0084  	MOVWF FSR
