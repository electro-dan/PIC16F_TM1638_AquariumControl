0A9D  0009  	RETFIE


/*********************************************************************************************
  void initialise()
  Function called once only to initialise variables and
  setup the PIC registers
*********************************************************************************************/
void initialise() {

    //PIC16F73 doesn't have an internal oscillator
    //pcon.OSCF = 1; // 4MHz internal osc

    // Configure port A
    /*
    RA7     Doesn't exist
    RA6     Doesn't exist
    RA5
    RA4
    RA3
    RA2
    RA1     OUT FANS
    RA0     OUT HEATER
    */
    trisa = 0x00; // all outputs
08B2  1683  	BSF STATUS, RP0
08B3  1303  	BCF STATUS, RP1
08B4  0185  	CLRF gbl_trisa

    porta = 0x00; // All off
08B5  1283  	BCF STATUS, RP0
08B6  0185  	CLRF gbl_porta


    // Configure port B
    /*
    RB7     ICSP PGD
    RB6     ICSP PGC
    RB5
    RB4
    RB3     OUT TM1638 STB
    RB2     OUT TM1638 CLK
    RB1     IN/OUT TM1638 DIO
    RB0
    */
    trisb = 0x00; // all outputs by default
08B7  1683  	BSF STATUS, RP0
08B8  0186  	CLRF gbl_trisb

    portb = 0x0E; // default TM1638 pins high
08B9  300E  	MOVLW 0x0E
08BA  1283  	BCF STATUS, RP0
08BB  0086  	MOVWF gbl_portb


    // Configure port C
    /*
    RC7
    RC6
    RC5     IN/OUT DS18B20
    RC4     IN/OUT DS3231M I2C SDA
    RC3     IN/OUT DS3231M I2C CLK
    RC2     OUT BLUE LIGHT PWM
    RC1     OUT WHITE LIGHT PWM
    RC0     IN SQW DS3231M
    */
    trisc = 0x21; // RC0 and RC5 inputs
08BC  3021  	MOVLW 0x21
08BD  1683  	BSF STATUS, RP0
08BE  0087  	MOVWF gbl_trisc

    portc = 0x38; // default DS18B20 and DS3231 pins high
08BF  3038  	MOVLW 0x38
08C0  1283  	BCF STATUS, RP0
08C1  0087  	MOVWF gbl_portc


    option_reg = 0;
08C2  1683  	BSF STATUS, RP0
08C3  0181  	CLRF gbl_option_reg

    option_reg.NOT_RBPU = 1; // disable port b pull ups
08C4  1781  	BSF gbl_option_reg,7


    // ADC setup
    // PIC16F73 doesn't have comparators, setting cmcon may be needed for some PICs
    //cmcon = 7; // disable all comparators so port a is usable as digital io
    adcon1 = 7; // Set RA0,RA1,RA2,RA5,RA3 all to digital I/O
08C5  3007  	MOVLW 0x07
08C6  009F  	MOVWF gbl_adcon1



    // Setup timer 0, used for flashing display
    // Timer calculator: http://eng-serve.com/pic/pic_timer.html
    // Timer0 Registers Prescaler= 256 - TMR0 Preset = 61 - Freq = 20.03 Hz - Period = 0.049920 seconds
    //option_reg.T0CS = 0; // bit 5  TMR0 Clock Source Select bit...0 = Internal Clock (CLKO) 1 = Transition on T0CKI pin
    //option_reg.T0SE = 0; // bit 4 TMR0 Source Edge Select bit 0 = low/high 1 = high/low
    //option_reg.PSA = 0; // bit 3  Prescaler Assignment bit...0 = Prescaler is assigned to the Timer0
    option_reg.PS2 = 1; // bits 2-0  PS2:PS0: Prescaler Rate Select bits
08C7  1501  	BSF gbl_option_reg,2

    option_reg.PS1 = 1;
08C8  1481  	BSF gbl_option_reg,1

    option_reg.PS0 = 1;
08C9  1401  	BSF gbl_option_reg,0

    tmr0 = TMR0PRELOAD; // preset for timer register (61)
08CA  303D  	MOVLW 0x3D
08CB  1283  	BCF STATUS, RP0
08CC  0081  	MOVWF gbl_tmr0

    intcon.T0IF = 0; // Clear timer 1 interrupt flag bit
08CD  110B  	BCF gbl_intcon,2

    intcon.T0IE = 1; // Timer 1 interrupt enabled
08CE  168B  	BSF gbl_intcon,5


    // Setup timer 1, used to update clock display and periodically ask for a temperature reading
    // Timer 1 setup - interrupt on DS3231 SQW 1Hz
    // Timer1 Registers Prescaler= 1 - TMR1 Preset = 65535 - Freq = 1 Hz
    // Bits 5-4 T1CKPS1:T1CKPS0 = 00: Prescaler Rate Select bits, 00 = 1:1 prescaler
    // Bit 3 T1OSCEN = 0: Timer1 LP Oscillator Enable Control bit, 0 = off
    // Bit 2 NOT_T1SYNC = 1: Timer1 External Clock Input Synchronization Control bit, 1 = Do not synchronize external clock input
    // Bit 1 TMR1CS = 1: Timer1 Clock Source Select bit, 1 = External clock from T1OSO/T1CKI pin (on the rising edge)
    // Bit 0 TMR1ON = 0: Timer1 On Bit, 0 = off
    t1con = 0b00000111;
08CF  3007  	MOVLW 0x07
08D0  0090  	MOVWF gbl_t1con

    tmr1h = TMR1HV;      // preset for timer1 MSB register
08D1  30FF  	MOVLW 0xFF
08D2  008F  	MOVWF gbl_tmr1h

    tmr1l = TMR1LV;      // preset for timer1 LSB register
08D3  008E  	MOVWF gbl_tmr1l

    pie1.TMR1IE = 1;     // Timer 1 interrupt
08D4  1683  	BSF STATUS, RP0
08D5  140C  	BSF gbl_pie1,0


    // No task at initialisation
    cTask = 0;
08D6  1283  	BCF STATUS, RP0
08D7  01CF  	CLRF gbl_cTask


    // I2C Bus initialisation - baud rate divisor not applicable for software implementation
    i2c_init(1);
08D8  3001  	MOVLW 0x01
08D9  00F5  	MOVWF i2c_INIT_00000_arg_i2c_divisor
08DA  118A  	BCF PCLATH,3
08DB  2505  	CALL i2c_INIT_00000


    // Startup delay
    delay_ms(500);
08DC  30F4  	MOVLW 0xF4
08DD  00F5  	MOVWF delay_ms_00000_arg_del
08DE  2084  	CALL delay_ms_00000


    // Read in variables from EEPROM
    at24c32ReadAll();
08DF  2636  	CALL at24c32Rea_00019


    // Check if the DS3231 needs initilising
    char cStatus = ds3231ReadRegister(0x0F); // Read the status register
08E0  300F  	MOVLW 0x0F
08E1  00F5  	MOVWF ds3231Read_0001D_arg_cRegAddress
08E2  2534  	CALL ds3231Read_0001D
08E3  0877  	MOVF CompTempVarRet552, W
08E4  00F4  	MOVWF initialise_00000_1_cStatus

    // If the oscillator (OSF bit in status register) has stopped, then init and write a default date/time
    // This is only expected first time, or backup battery not present/empty in DS3231M module
    if (cStatus.7) {
08E5  158A  	BSF PCLATH,3
08E6  1FF4  	BTFSS initialise_00000_1_cStatus,7
08E7  28EB  	GOTO	label150
08EB        label150

        ds3231Init();
08E8  118A  	BCF PCLATH,3
08E9  2549  	CALL ds3231Init_00000

        ds3231WriteDateTime();
08EA  2518  	CALL ds3231Writ_0001B

    }

    tm1638DisplayOn();
08EB  118A  	BCF PCLATH,3
08EC  24D9  	CALL tm1638Disp_0001F

    tm1638UpdateDisplay();
08ED  22B4  	CALL tm1638Upda_00022


    // Enable interrupts
    intcon.GIE = 1;
08EE  178B  	BSF gbl_intcon,7

    intcon.PEIE = 1;
08EF  170B  	BSF gbl_intcon,6

}
08F0  0008  	RETURN


/*********************************************************************************************
  void main()
  Entry method. Loops infinitely with a simple task scheduler.
*********************************************************************************************/
void main() {

    initialise();
091C  20B2  	CALL initialise_00000


    // Endless loop
    while(1) {
091D        label151

        // Task scheduler
        // If there are tasks to be performed, find out the
        // most recent task from the array and execute it
        while (cTask > 0) {
091D  084F  	MOVF gbl_cTask, W
091E  3C00  	SUBLW 0x00
091F  158A  	BSF PCLATH,3
0920  1803  	BTFSC STATUS,C
0921  291D  	GOTO	label151

            if (cTask.TASK_TIMER1) {
0922  1D4F  	BTFSS gbl_cTask,2
0923  29EC  	GOTO	label171
09EC        label171

                if (!gcSetMode) {
0924  08D2  	MOVF gbl_gcSetMode, F
0925  1D03  	BTFSS STATUS,Z
0926  296E  	GOTO	label157

                    // Don't read date/time when in set mode
                    ds3231ReadDateTime();
0927  20F1  	CALL ds3231Read_0001C

                    if ((gBcdSecond == 0x29) || (gBcdSecond == 0x59)) {
0928  0835  	MOVF gbl_gBcdSecond, W
0929  3A29  	XORLW 0x29
092A  158A  	BSF PCLATH,3
092B  1903  	BTFSC STATUS,Z
092C  2931  	GOTO	label152
092D  0835  	MOVF gbl_gBcdSecond, W
092E  3A59  	XORLW 0x59
092F  1D03  	BTFSS STATUS,Z
0930  2936  	GOTO	label153
0931        label152
0936        label153

                        // Ask to convert for temperature reading at 29 seconds or 59 seconds past the minute
                        oneWireBusReset();
0931  2099  	CALL oneWireBus_00014

                        startTemp();
0932  158A  	BSF PCLATH,3
0933  2013  	CALL startTemp_00000

                    } else if ((gBcdSecond == 0) || (gBcdSecond == 0x30)) {
0934  158A  	BSF PCLATH,3
0935  2941  	GOTO	label155
0936  08B5  	MOVF gbl_gBcdSecond, F
0937  1903  	BTFSC STATUS,Z
0938  293D  	GOTO	label154
0939  0835  	MOVF gbl_gBcdSecond, W
093A  3A30  	XORLW 0x30
093B  1D03  	BTFSS STATUS,Z
093C  2941  	GOTO	label155
093D        label154
0941        label155
0A1C  158A  	BSF PCLATH,3
0A1D  291D  	GOTO	label151

                        // 1 second later, read the converted temperature
                        oneWireBusReset();
093D  2099  	CALL oneWireBus_00014

                        readTemp();
093E  158A  	BSF PCLATH,3
093F  201C  	CALL readTemp_00000

                        // store it in the array, next display refresh will pick it up
                        convertTemp();
0940  2554  	CALL convertTem_00027

                    }
                    // daylight savings time handling (UK/europe) - last sunday of March or October (this can fall between the 25th and the 31st)
                    if ((gBcdSecond == 0) && (gBcdMinute == 0) && (gDayOfWeek == 7) && (gBcdDayOfMonth > 0x24) && (gBcdMonth != gBcdDSTLastOccurred)) {
0941  08B5  	MOVF gbl_gBcdSecond, F
0942  158A  	BSF PCLATH,3
0943  1D03  	BTFSS STATUS,Z
0944  296E  	GOTO	label157
0945  08B6  	MOVF gbl_gBcdMinute, F
0946  1D03  	BTFSS STATUS,Z
0947  296E  	GOTO	label157
0948  0838  	MOVF gbl_gDayOfWeek, W
0949  3A07  	XORLW 0x07
094A  1D03  	BTFSS STATUS,Z
094B  296E  	GOTO	label157
094C  0839  	MOVF gbl_gBcdDayOfMonth, W
094D  3C24  	SUBLW 0x24
094E  1803  	BTFSC STATUS,C
094F  296E  	GOTO	label157
0950  083C  	MOVF gbl_gBcdDSTLastOccurred, W
0951  063A  	XORWF gbl_gBcdMonth, W
0952  1903  	BTFSC STATUS,Z
0953  296E  	GOTO	label157

                        // In March, at 1AM, apply daylight savings time if appropriate
                        if ((gBcdHour == 1) && (gBcdMonth == 3)) {
0954  0337  	DECF gbl_gBcdHour, W
0955  1D03  	BTFSS STATUS,Z
0956  2960  	GOTO	label156
0957  083A  	MOVF gbl_gBcdMonth, W
0958  3A03  	XORLW 0x03
0959  1D03  	BTFSS STATUS,Z
095A  2960  	GOTO	label156
0960        label156

                            gBcdHour++; // one hour forwards
095B  0AB7  	INCF gbl_gBcdHour, F

                            ds3231WriteDateTime();
095C  118A  	BCF PCLATH,3
095D  2518  	CALL ds3231Writ_0001B

                            gBcdDSTLastOccurred = 3;
095E  3003  	MOVLW 0x03
095F  00BC  	MOVWF gbl_gBcdDSTLastOccurred

                        }
                        // In October, at 2AM, remove daylight savings time if appropriate (UK/europe) daylight savings time if appropriate (UK/europe) - last sunday of October
                        if ((gBcdHour == 2) && (gBcdMonth == 0x10)) {
0960  0837  	MOVF gbl_gBcdHour, W
0961  3A02  	XORLW 0x02
0962  158A  	BSF PCLATH,3
0963  1D03  	BTFSS STATUS,Z
0964  296E  	GOTO	label157
0965  083A  	MOVF gbl_gBcdMonth, W
0966  3A10  	XORLW 0x10
0967  1D03  	BTFSS STATUS,Z
0968  296E  	GOTO	label157
096E        label157

                            gBcdHour--; // one hour back
0969  03B7  	DECF gbl_gBcdHour, F

                            ds3231WriteDateTime();
096A  118A  	BCF PCLATH,3
096B  2518  	CALL ds3231Writ_0001B

                            gBcdDSTLastOccurred = 0x10;
096C  3010  	MOVLW 0x10
096D  00BC  	MOVWF gbl_gBcdDSTLastOccurred

                        }
                    }
                }
                if (!gcTriggerMode) {
096E  08D4  	MOVF gbl_gcTriggerMode, F
096F  158A  	BSF PCLATH,3
0970  1D03  	BTFSS STATUS,Z
0971  29E3  	GOTO	label169

                    // Don't activate triggers when in trigger set mode
                    // Trigger white led
                    // Don't activate/deactivate if on and off set hour/min are the same
                    if ((gBcdWhiteOnHour != gBcdWhiteOffHour) || (gBcdWhiteOnMinute != gBcdWhiteOffMinute)) {
0972  0858  	MOVF gbl_gBcdWhiteOffHour, W
0973  0656  	XORWF gbl_gBcdWhiteOnHour, W
0974  1D03  	BTFSS STATUS,Z
0975  297A  	GOTO	label158
0976  0857  	MOVF gbl_gBcdWhiteOffMinute, W
0977  0655  	XORWF gbl_gBcdWhiteOnMinute, W
0978  1903  	BTFSC STATUS,Z
0979  298A  	GOTO	label160
097A        label158

                        if ((gBcdHour == gBcdWhiteOnHour) && (gBcdMinute == gBcdWhiteOnMinute)) {
097A  0856  	MOVF gbl_gBcdWhiteOnHour, W
097B  0637  	XORWF gbl_gBcdHour, W
097C  1D03  	BTFSS STATUS,Z
097D  2982  	GOTO	label159
097E  0855  	MOVF gbl_gBcdWhiteOnMinute, W
097F  0636  	XORWF gbl_gBcdMinute, W
0980  1903  	BTFSC STATUS,Z

                            WHITE_LED = 1;
0981  1487  	BSF gbl_portc,1
0982        label159

                        }
                        if ((gBcdHour == gBcdWhiteOffHour) && (gBcdMinute == gBcdWhiteOffMinute)) {
0982  0858  	MOVF gbl_gBcdWhiteOffHour, W
0983  0637  	XORWF gbl_gBcdHour, W
0984  1D03  	BTFSS STATUS,Z
0985  298A  	GOTO	label160
0986  0857  	MOVF gbl_gBcdWhiteOffMinute, W
0987  0636  	XORWF gbl_gBcdMinute, W
0988  1903  	BTFSC STATUS,Z

                            WHITE_LED = 0;
0989  1087  	BCF gbl_portc,1
098A        label160

                        }
                    }
                    // Trigger blue led
                    // Don't activate/deactivate if on and off set hour/min are the same
                    if ((gBcdBlueOnHour != gBcdBlueOffHour) || (gBcdBlueOnMinute != gBcdBlueOffMinute)) {
098A  085C  	MOVF gbl_gBcdBlueOffHour, W
098B  065A  	XORWF gbl_gBcdBlueOnHour, W
098C  1D03  	BTFSS STATUS,Z
098D  2992  	GOTO	label161
098E  085B  	MOVF gbl_gBcdBlueOffMinute, W
098F  0659  	XORWF gbl_gBcdBlueOnMinute, W
0990  1903  	BTFSC STATUS,Z
0991  29A2  	GOTO	label163
0992        label161

                        if ((gBcdHour == gBcdBlueOnHour) && (gBcdMinute == gBcdBlueOnMinute)) {
0992  085A  	MOVF gbl_gBcdBlueOnHour, W
0993  0637  	XORWF gbl_gBcdHour, W
0994  1D03  	BTFSS STATUS,Z
0995  299A  	GOTO	label162
0996  0859  	MOVF gbl_gBcdBlueOnMinute, W
0997  0636  	XORWF gbl_gBcdMinute, W
0998  1903  	BTFSC STATUS,Z

                            BLUE_LED = 1;
0999  1507  	BSF gbl_portc,2
099A        label162

                        }
                        if ((gBcdHour == gBcdBlueOffHour) && (gBcdMinute == gBcdBlueOffMinute)) {
099A  085C  	MOVF gbl_gBcdBlueOffHour, W
099B  0637  	XORWF gbl_gBcdHour, W
099C  1D03  	BTFSS STATUS,Z
099D  29A2  	GOTO	label163
099E  085B  	MOVF gbl_gBcdBlueOffMinute, W
099F  0636  	XORWF gbl_gBcdMinute, W
09A0  1903  	BTFSC STATUS,Z

                            BLUE_LED = 0;
09A1  1107  	BCF gbl_portc,2
09A2        label163

                        }
                    }
                    // 2nd Trigger blue led
                    // Don't activate/deactivate if on and off set hour/min are the same
                    if ((gBcdBlue2OnHour != gBcdBlue2OffHour) || (gBcdBlue2OnMinute != gBcdBlue2OffMinute)) {
09A2  0860  	MOVF gbl_gBcdBlue2OffHour, W
09A3  065E  	XORWF gbl_gBcdBlue2OnHour, W
09A4  1D03  	BTFSS STATUS,Z
09A5  29AA  	GOTO	label164
09A6  085F  	MOVF gbl_gBcdBlue2OffMinute, W
09A7  065D  	XORWF gbl_gBcdBlue2OnMinute, W
09A8  1903  	BTFSC STATUS,Z
09A9  29BA  	GOTO	label166
09AA        label164

                        if ((gBcdHour == gBcdBlue2OnHour) && (gBcdMinute == gBcdBlue2OnMinute)) {
09AA  085E  	MOVF gbl_gBcdBlue2OnHour, W
09AB  0637  	XORWF gbl_gBcdHour, W
09AC  1D03  	BTFSS STATUS,Z
09AD  29B2  	GOTO	label165
09AE  085D  	MOVF gbl_gBcdBlue2OnMinute, W
09AF  0636  	XORWF gbl_gBcdMinute, W
09B0  1903  	BTFSC STATUS,Z

                            BLUE_LED = 1;
09B1  1507  	BSF gbl_portc,2
09B2        label165

                        }
                        if ((gBcdHour == gBcdBlue2OffHour) && (gBcdMinute == gBcdBlue2OffMinute)) {
09B2  0860  	MOVF gbl_gBcdBlue2OffHour, W
09B3  0637  	XORWF gbl_gBcdHour, W
09B4  1D03  	BTFSS STATUS,Z
09B5  29BA  	GOTO	label166
09B6  085F  	MOVF gbl_gBcdBlue2OffMinute, W
09B7  0636  	XORWF gbl_gBcdMinute, W
09B8  1903  	BTFSC STATUS,Z

                            BLUE_LED = 0;
09B9  1107  	BCF gbl_portc,2
09BA        label166

                        }
                    }
                    // Trigger fan
                    if (giDS3231ValueTruncCBCD >= gBcdFanOnTemp) {
09BA  0861  	MOVF gbl_gBcdFanOnTemp, W
09BB  024D  	SUBWF gbl_giDS3231ValueTruncCBCD, W
09BC  1803  	BTFSC STATUS,C

                        FAN = 1;
09BD  1485  	BSF gbl_porta,1

                    }
                    if (giDS3231ValueTruncCBCD < gBcdFanOffTemp) {
09BE  0862  	MOVF gbl_gBcdFanOffTemp, W
09BF  024D  	SUBWF gbl_giDS3231ValueTruncCBCD, W
09C0  1803  	BTFSC STATUS,C
09C1  29D6  	GOTO	label168

                        // Fan off
                        FAN = 0;
09C2  1085  	BCF gbl_porta,1

                        // but turn fans on for a minute every 6 hours - helps reduce condensation damage
                        if ((gBcdHour == 0) || (gBcdHour == 6) || (gBcdHour == 12) || (gBcdHour == 18)) {
09C3  08B7  	MOVF gbl_gBcdHour, F
09C4  1903  	BTFSC STATUS,Z
09C5  29D2  	GOTO	label167
09C6  0837  	MOVF gbl_gBcdHour, W
09C7  3A06  	XORLW 0x06
09C8  1903  	BTFSC STATUS,Z
09C9  29D2  	GOTO	label167
09CA  0837  	MOVF gbl_gBcdHour, W
09CB  3A0C  	XORLW 0x0C
09CC  1903  	BTFSC STATUS,Z
09CD  29D2  	GOTO	label167
09CE  0837  	MOVF gbl_gBcdHour, W
09CF  3A12  	XORLW 0x12
09D0  1D03  	BTFSS STATUS,Z
09D1  29D6  	GOTO	label168
09D2        label167

                            if (gBcdMinute == 0)
09D2  08B6  	MOVF gbl_gBcdMinute, F
09D3  1D03  	BTFSS STATUS,Z
09D4  29D6  	GOTO	label168
09D6        label168

                                FAN = 1;
09D5  1485  	BSF gbl_porta,1

                        }
                    }
                    // Forced on
                    if (gbFanOn)
09D6  1850  	BTFSC gbl_gbFanOn,0

                        FAN = 1;
09D7  1485  	BSF gbl_porta,1

                    // Trigger heater
                    if (giDS3231ValueTruncCBCD < gBcdHeaterOnTemp) {
09D8  0863  	MOVF gbl_gBcdHeaterOnTemp, W
09D9  024D  	SUBWF gbl_giDS3231ValueTruncCBCD, W
09DA  1C03  	BTFSS STATUS,C

                        HEATER = 1;
09DB  1405  	BSF gbl_porta,0

                    }
                    if (giDS3231ValueTruncCBCD >= gBcdHeaterOffTemp) {
09DC  0864  	MOVF gbl_gBcdHeaterOffTemp, W
09DD  024D  	SUBWF gbl_giDS3231ValueTruncCBCD, W
09DE  1803  	BTFSC STATUS,C

                        HEATER = 0;
09DF  1005  	BCF gbl_porta,0

                    }
                    // If temperature is minus, always trigger heater
                    if (gbDS3231IsMinus)
09E0  08CE  	MOVF gbl_gbDS3231IsMinus, F
09E1  1D03  	BTFSS STATUS,Z

                        HEATER = 1;
09E2  1405  	BSF gbl_porta,0
09E3        label169

                }
                // Display time and temperature or date on TM1638 after clock tick
                if (!gcTriggerMode && !gcSetMode) {
09E3  08D4  	MOVF gbl_gcTriggerMode, F
09E4  1D03  	BTFSS STATUS,Z
09E5  29EB  	GOTO	label170
09E6  08D2  	MOVF gbl_gcSetMode, F
09E7  1D03  	BTFSS STATUS,Z
09E8  29EB  	GOTO	label170
09EB        label170

                    tm1638UpdateDisplay();
09E9  118A  	BCF PCLATH,3
09EA  22B4  	CALL tm1638Upda_00022

                }

                cTask.TASK_TIMER1 = 0;
09EB  114F  	BCF gbl_cTask,2

            }
            if (cTask.TASK_TIMER0) {
09EC  158A  	BSF PCLATH,3
09ED  1CCF  	BTFSS gbl_cTask,1
09EE  291D  	GOTO	label151

                // Task should happen about every 50ms
                // Digit flashing - see if 10 counts has happened for an ~half second count
                iTimer0FlashCounts++;
09EF  0ABF  	INCF gbl_iTimer0FlashCounts, F

                if (iTimer0FlashCounts > 9) {
09F0  083F  	MOVF gbl_iTimer0FlashCounts, W
09F1  3C09  	SUBLW 0x09
09F2  1803  	BTFSC STATUS,C
09F3  29FE  	GOTO	label173

                    iFlashDigitOff++;
09F4  0AC9  	INCF gbl_iFlashDigitOff, F

                    iTimer0FlashCounts = 0;
09F5  01BF  	CLRF gbl_iTimer0FlashCounts

                    // If in set or trigger mode, update the display every ~half second to flash a digit
                    if (gcSetMode || gcTriggerMode)
09F6  08D2  	MOVF gbl_gcSetMode, F
09F7  1D03  	BTFSS STATUS,Z
09F8  29FC  	GOTO	label172
09F9  08D4  	MOVF gbl_gcTriggerMode, F
09FA  1903  	BTFSC STATUS,Z
09FB  29FE  	GOTO	label173
09FC        label172

                        tm1638UpdateDisplay();
09FC  118A  	BCF PCLATH,3
09FD  22B4  	CALL tm1638Upda_00022

                }
                // Poll keys
                tm1638ReadKeys();
09FE  118A  	BCF PCLATH,3
09FF  27F0  	CALL tm1638Read_00025

                // Button state changed
                char processKeys = 0;
0A00  01F4  	CLRF main_113_processKeys

                if (tm1638Keys != tm1638KeysOld) {
0A01  086E  	MOVF gbl_tm1638KeysOld, W
0A02  066D  	XORWF gbl_tm1638Keys, W
0A03  1903  	BTFSC STATUS,Z
0A04  2A08  	GOTO	label174
0A08        label174

                    processKeys = 1;
0A05  3001  	MOVLW 0x01
0A06  00F4  	MOVWF main_113_processKeys

                } else if (tm1638Keys != 0) {
0A07  2A12  	GOTO	label175
0A08  08ED  	MOVF gbl_tm1638Keys, F
0A09  1903  	BTFSC STATUS,Z
0A0A  2A12  	GOTO	label175

                    // Button held
                    iTimer0KeyCounts++;
0A0B  0AC8  	INCF gbl_iTimer0KeyCounts, F

                    // If button held more than 250ms
                    if (iTimer0KeyCounts > 4) {
0A0C  0848  	MOVF gbl_iTimer0KeyCounts, W
0A0D  3C04  	SUBLW 0x04
0A0E  1803  	BTFSC STATUS,C
0A0F  2A12  	GOTO	label175
0A12        label175

                        processKeys = 1;
0A10  3001  	MOVLW 0x01
0A11  00F4  	MOVWF main_113_processKeys

                    }
                }
                if (processKeys) {
0A12  08F4  	MOVF main_113_processKeys, F
0A13  1903  	BTFSC STATUS,Z
0A14  2A1B  	GOTO	label176
0A1B        label176

                    processKeys();
0A15  202B  	CALL processKey_0002A

                    tm1638UpdateDisplay();
0A16  118A  	BCF PCLATH,3
0A17  22B4  	CALL tm1638Upda_00022

                    tm1638KeysOld = tm1638Keys;
0A18  086D  	MOVF gbl_tm1638Keys, W
0A19  00EE  	MOVWF gbl_tm1638KeysOld

                    iTimer0KeyCounts = 0;
0A1A  01C8  	CLRF gbl_iTimer0KeyCounts

                }
                cTask.TASK_TIMER0 = 0;
0A1B  10CF  	BCF gbl_cTask,1

            }
        }
    }
}


////////////////////////////////////////////////////////////////////////////
// I2C Communications Library for I2C MASTER
////////////////////////////////////////////////////////////////////////////
// Author(s): Andrew Smallridge
// Date 15 November 2004
//
// Copyright(C) 2004-2006 Andrew Smallridge
// Copyright(C) 2004-2010 Pavel Baranov
// Copyright(C) 2004-2010 David Hobday
// Existing constants predefined for i2c hardware driver and i2s software
// emulation for the PIC 18F2xx and 18F4xx processors. For hardware support
// on other PICs the constants must be mapped to the corresponding register
// map of the target device
////////////////////////////////////////////////////////////////////////////

/*
////////////////////////////////////////////////////////////////////////////
//	The following three sections should be copied to the user's program:
//		i2c master hardware / software mode definition
//		i2c software implementation template arguments and variables
// 		i2c hardwareware implementation template arguments
////////////////////////////////////////////////////////////////////////////
//
//
////////////////////////////////////////////////////////////////////////////
// i2c master hardware / software mode definition
//
// For i2c hardware support comment out the #define use_ic2_SW line
////////////////////////////////////////////////////////////////////////////
//#define use_i2c_SW

#if defined use_i2c_SW
////////////////////////////////////////////////////////////////////////////
// i2c software implementation template arguments and variables
////////////////////////////////////////////////////////////////////////////
#define i2c_ARGS	3, PORTC, TRISC, 4, PORTC, TRISC, e_SSPCON1, e_SSPCON2, \
					e_SSPSTAT, e_SSPBUF, e_SSPIF_BIT, e_SSPIF_PIR,			\
					e_BCLIF_BIT, e_BCLIF_PIR, 7, e_SSPADD, (i2c_reset_wdt | i2c_SMP)

// RAM used by the software i2c driver to emulate the equivalent i2c hardware registers					
unsigned short swi2c_SSPCON1@0x40;	// define location for the emulated SSPCON1
unsigned short swi2c_SSPCON2@0x41;	// define location for the emulated SSPCON2
unsigned short swi2c_SSPSTAT@0x42;	// define location for the emulated SSPSTAT
unsigned short swi2c_SSPBUF@0x43;	// define location for the emulated SSPBUF
unsigned short swi2c_SSPIF_PIR@0x44;// define location for the emulated SSPIF_PIR
unsigned short swi2c_BCLIF_PIR@0x45;// define location for the emulated BCLIF_PIR
unsigned short swi2c_SSPADD@0x46;	// define location for the emulated SSPADD

// variables cannot be passed as template arguments. The following constants map to
// the PIC registers and software emalated i2c RAM locations. These constants are
// then used by the templated functions. When changing the address of an emulated
// register the corresponding constant mapping must also be changed.
#define e_SSPCON1	0x40
#define e_SSPCON2	0x41
#define e_SSPSTAT	0x42
#define e_SSPADD	0x43
#define e_SSPBUF	0x44
#define e_SSPIF_PIR	0x45
#define e_BCLIF_PIR	0x46
#define e_SSPIF_BIT	3
#define e_BCLIF_BIT	3					

#else
////////////////////////////////////////////////////////////////////////////
// i2c hardwareware implementation template arguments
////////////////////////////////////////////////////////////////////////////
#define i2c_ARGS	3, PORTC, TRISC, 4, PORTC, TRISC, e_SSPCON1, e_SSPCON2, \
					e_SSPSTAT, e_SSPBUF, e_SSPIF_BIT, e_SSPIF_PIR,			\
					e_BCLIF_BIT, e_BCLIF_PIR, 7, e_SSPADD, (i2c_reset_wdt | i2c_SMP |i2c_HW)

// variables cannot be passed as template arguments. The following constants map to
// the PIC registers and PIC's i2c register locations. These constants are
// then used by the templated functions. 
#define PORTC		0x0f82
#define TRISC		0x0f94
#define e_SSPCON1	0xfc6
#define e_SSPCON2	0xfc5
#define e_SSPSTAT	0xfc7
#define e_SSPADD	0xfc8
#define e_SSPBUF	0xfc9
#define e_SSPIF_PIR	0xf9e
#define e_BCLIF_PIR	0xfa1
#define e_SSPIF_BIT	3
#define e_BCLIF_BIT	3

#endif

*/


////////////////////////////////////////////////////////////////////////////
// Define the common i2c template structure
////////////////////////////////////////////////////////////////////////////
#define _I2C_TEMPL	template <unsigned char T_SCL_BIT, unsigned short T_SCL_PORT,	\
					unsigned short T_SCL_TRIS, unsigned char T_SDA_BIT, 			\
					unsigned short T_SDA_PORT, unsigned short T_SDA_TRIS,			\
					unsigned short T_i2c_SSPCON1, unsigned short T_i2c_SSPCON2, 	\
					unsigned short T_i2c_SSPSTAT, unsigned short T_i2c_SSPBUF, 		\
					unsigned char T_i2c_SSPIF_BIT, unsigned short T_i2c_SSPIF_PIR,	\
					unsigned char T_i2c_BCLIF_BIT, unsigned short T_i2c_BCLIF_PIR,	\
					unsigned char T_i2c_SMP_BIT, unsigned short T_i2c_SSPADD, 		\
					unsigned char T_MODE>

////////////////////////////////////////////////////////////////////////////
// Define the common i2c template parameters
////////////////////////////////////////////////////////////////////////////
#define _I2C_TEMPL_ARGS	T_SCL_BIT, T_SCL_PORT, T_SCL_TRIS, T_SDA_BIT, 			\
						T_SDA_PORT, T_SDA_TRIS, T_i2c_SSPCON1, T_i2c_SSPCON2, 	\
						T_i2c_SSPSTAT, T_i2c_SSPBUF, T_i2c_SSPIF_BIT, 			\
						T_i2c_SSPIF_PIR, T_i2c_BCLIF_BIT, T_i2c_BCLIF_PIR,		\
						T_i2c_SMP_BIT, T_i2c_SSPADD, T_MODE

////////////////////////////////////////////////////////////////////////////
// Helpers that hide template arguments
////////////////////////////////////////////////////////////////////////////
#define i2c_init	i2c_INIT<i2c_ARGS>
#define i2c_start	i2c_START<i2c_ARGS>
#define i2c_restart	i2c_RESTART<i2c_ARGS>
#define i2c_stop	i2c_STOP<i2c_ARGS>
#define i2c_read	i2c_READ<i2c_ARGS>
#define i2c_write	i2c_WRITE<i2c_ARGS>


////////////////////////////////////////////////////////////////////////////
// I2C Control Status Bits - Emulates the PIC18F hardware I2C implementation
////////////////////////////////////////////////////////////////////////////
// define I2C i2C_SSPCON1 control bits
#define	i2c_WCOL	7
#define	i2c_SSPOV	6
#define	i2c_SSPEN	5
#define	i2c_CKP		4
#define	i2c_SSPM3	3
#define	i2c_SSPM2	2
#define	i2c_SSPM1	1
#define	i2c_SSPM0	0

// define I2C SSPCON2 control bits
#define	i2c_GCEN 	7
#define	i2c_ACKSTAT	6
#define	i2c_ACKDT	5
#define	i2c_ACKEN	4
#define	i2c_RCEN	3
#define	i2c_PEN		2
#define	i2c_RSEN	1
#define	i2c_SEN		0

// define I2C SSPSTAT status bits
#define	i2c_DA		5
#define	i2c_P		4
#define	i2c_S		3
#define	i2c_RW		2
#define	i2c_UA		1
#define	i2c_BF		0


////////////////////////////////////////////////////////////////////////////
// I2C Control Flag Bits
////////////////////////////////////////////////////////////////////////////
// define I2C Mode bits
#define	i2c_HW			0x01
#define	i2c_400KHz		0x02	// 100KHz or 400KHz I2C clock (set = 400KHz)
#define	i2c_reset_wdt	0x04
#define i2c_SMP			0x80	


////////////////////////////////////////////////////////////////////////////
// I2C software constants
////////////////////////////////////////////////////////////////////////////
#define	dly 10	// number of 1us delay increments



////////////////////////////////////////////////////////////////////////////
// Generates the I2C Bus Start Condition
////////////////////////////////////////////////////////////////////////////
_I2C_TEMPL 
void i2c_START(void)

{
	// Initiate the I2C START condition
	volatile bit l_scl@T_SCL_PORT.T_SCL_BIT, l_sda@T_SDA_PORT.T_SDA_BIT;
	volatile bit l_scl_tris@T_SCL_TRIS.T_SCL_BIT, l_sda_tris@T_SDA_TRIS.T_SDA_BIT;
	volatile bit l_sspif@T_i2c_SSPIF_PIR.T_i2c_SSPIF_BIT, l_bclif@T_i2c_BCLIF_PIR.T_i2c_BCLIF_BIT;
	volatile bit l_rw@T_i2c_SSPSTAT.i2c_RW, l_s@T_i2c_SSPSTAT.i2c_S, l_sen@T_i2c_SSPCON2.i2c_SEN;
	volatile bit l_rcen@T_i2c_SSPCON2.i2c_RCEN, l_pen@T_i2c_SSPCON2.i2c_PEN;
	volatile bit l_rsen@T_i2c_SSPCON2.i2c_RSEN, l_acken@T_i2c_SSPCON2.i2c_ACKEN;
		
	delay_us(dly);
012A  300A  	MOVLW 0x0A
012B  1283  	BCF STATUS, RP0
012C  1303  	BCF STATUS, RP1
012D  00FA  	MOVWF delay_us_00000_arg_del
012E  2010  	CALL delay_us_00000

	l_bclif = 0; // initialise the collision flag for this command
012F  11C6  	BCF i2c_START_00000_1_l_bclif,3

	l_sspif = 0;
0130  11C5  	BCF i2c_START_00000_1_l_sspif,3

		
	if (T_MODE & i2c_HW)
	{
		//	Hardware I2C implementation
		while (l_acken || l_rcen || l_pen || l_rsen || l_sen || l_rw)
			if (T_MODE & i2c_reset_wdt)
				clear_wdt();
			
		l_sen = 1; // initiate START condition	

		while (l_acken || l_rcen || l_pen || l_rsen || l_sen || l_rw || !l_sspif)
			if (T_MODE & i2c_reset_wdt)
				clear_wdt();
	}
	else
	{
		//	Software I2C implementation			
		l_sen = 1; // initiate START condition
0131  1441  	BSF i2c_START_00000_1_l_sen,0

		l_scl_tris = 1; // ensure the SCL line is high
