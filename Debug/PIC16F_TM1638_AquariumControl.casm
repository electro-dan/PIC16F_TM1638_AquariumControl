05F7  01F7  	CLRF i2c_WRITE_00000_arg_i2c_data
05F8  20A9  	CALL i2c_WRITE_00000

    i2c_write(0); // Second word address
05F9  01F7  	CLRF i2c_WRITE_00000_arg_i2c_data
05FA  20A9  	CALL i2c_WRITE_00000

