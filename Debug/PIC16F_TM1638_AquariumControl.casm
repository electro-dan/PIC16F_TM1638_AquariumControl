01D8  300A  	MOVLW 0x0A
01D9  1283  	BCF STATUS, RP0
01DA  027D  	SUBWF intToBcd_00000_arg_iValue, W
01DB        label33
01DB  1C03  	BTFSS STATUS,C
01DC  29E8  	GOTO	label34
01E7  29CF  	GOTO	label32
01E8        label34

        iValue -= 10;
